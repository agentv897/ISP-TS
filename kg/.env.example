# ToxiGraph DILI Platform - Environment Configuration
# Copy this file to .env and fill in your values

# Flask
PORT=4001
FLASK_DEBUG=true

# Google Cloud Spanner (optional - app falls back to mock mode)
SPANNER_PROJECT_ID=your-project-id
SPANNER_INSTANCE_ID=your-instance-id
SPANNER_DATABASE_ID=your-database-id
